# OpenRouter key used by /api/chat. Without it (or with MOCK_LLM=1) the agent runs in scripted demo mode.
OPENROUTER_API_KEY=
# Any OpenRouter model id with tool calling. Can also be changed in Settings at runtime.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Jev (TypeSafe System One) model on OpenRouter, used for the fast path. Same OPENROUTER_API_KEY.
JEV_MODEL=jev-latest
# MOCK_LLM=1
